{
  "name": "@ged/database",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "db:migrate": "ts-node ./src/migrations/run.ts",
    "db:migrate:revert": "typeorm migration:revert",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.5.0"
  }
}
