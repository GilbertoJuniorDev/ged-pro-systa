DATABASE_URL=postgresql://ged_user:ged_password@localhost:5432/ged_systa
REDIS_URL=redis://localhost:6379
JWT_SECRET=troque-por-um-segredo-forte-de-pelo-menos-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=outro-segredo-forte-diferente-do-jwt-secret
JWT_REFRESH_EXPIRES_IN=7d
NODE_ENV=development
PORT=3333

# Storage — Google Drive (OAuth2 + refresh token)
# Client ID/Secret vêm do OAuth Client criado no Google Cloud Console.
# GOOGLE_DRIVE_REFRESH_TOKEN é gerado uma vez via consent flow (escopo drive.file) e não expira
# enquanto o app OAuth estiver em produção (ou o usuário de teste permanecer autorizado).
# GOOGLE_DRIVE_FOLDER_ID é a pasta (My Drive ou Shared Drive) onde os documentos são enviados.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
STORAGE_MAX_FILE_SIZE=26214400

# Email — use localhost quando a API roda fora do Docker; mailhog quando dentro do Docker
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@ged.local
